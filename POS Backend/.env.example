# ─── Server ─────────────────────────────────────────────
NODE_ENV=development
# macOS reserves :5000 for AirPlay Receiver — use :4000 by default.
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=*

# ─── Database ───────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/pos_management

# ─── Auth ───────────────────────────────────────────────
JWT_SECRET=change-this-super-secret-key-in-production
JWT_EXPIRES_IN=12h
BCRYPT_SALT_ROUNDS=10

# ─── Billing ────────────────────────────────────────────
# Tax rate as a percent value (e.g. 5 => 5%)
DEFAULT_TAX_RATE=5
CURRENCY=INR
CURRENCY_SYMBOL=Rs.
RESTAURANT_NAME=My Restaurant
RESTAURANT_ADDRESS=Street, City
RESTAURANT_PHONE=+91-00000-00000
RESTAURANT_GSTIN=

# ─── Printer ────────────────────────────────────────────
# Modes: network | usb | file (file is used for dev/debug)
PRINTER_MODE=file
PRINTER_FILE_DIR=./print-queue

# Kitchen Printer
KITCHEN_PRINTER_HOST=192.168.1.100
KITCHEN_PRINTER_PORT=9100
KITCHEN_PRINTER_VENDOR_ID=
KITCHEN_PRINTER_PRODUCT_ID=

# Counter Printer
COUNTER_PRINTER_HOST=192.168.1.101
COUNTER_PRINTER_PORT=9100
COUNTER_PRINTER_VENDOR_ID=
COUNTER_PRINTER_PRODUCT_ID=

# Paper width (chars per line): 32 for 58mm, 48 for 80mm
PRINTER_WIDTH=48
