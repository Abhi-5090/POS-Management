# Point at the main POS backend. Leave VITE_API_URL empty to use the
# Vite dev proxy (VITE_API_PROXY_TARGET) — simplest for local dev.
VITE_API_URL=
VITE_API_PREFIX=/api/v1

# Vite dev proxy target for /api (and that's it — no sockets here).
VITE_API_PROXY_TARGET=http://localhost:4000

# UI convenience
VITE_CURRENCY_SYMBOL=₹
